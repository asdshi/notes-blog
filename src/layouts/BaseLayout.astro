---
import "../styles/global.css";

const { title = "笔记大全", description = "基于 Astro 的轻量个人博客" } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <main>
      <header class="site">
        <p class="eyebrow">PERSONAL KNOWLEDGE SYSTEM</p>
        <h1><a href="/">笔记大全</a></h1>
        <p>面试八股、后端原理与工程化实践整理</p>
        <nav class="top-nav" aria-label="主导航">
          <a href="/">首页</a>
          <a href="/archive/">归档</a>
          <a href="/about/">关于</a>
        </nav>
      </header>
      <slot />
    </main>
  </body>
</html>
