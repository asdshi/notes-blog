---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="首页 | 笔记博客" description="我的学习笔记与面试整理">
  <section class="hero-grid reveal">
    <article class="hero-main card">
      <p class="hero-kicker">EDITORIAL NOTEBOOK / 2026</p>
      <h2>把碎片化学习内容，整理成可持续迭代的知识出版物。</h2>
      <p class="hero-desc">
        这里不是单纯的文章列表，而是按主题演进的长期知识工程。
      </p>
      <div class="metrics">
        <article>
          <span>文章总数</span>
          <strong id="metric-post-count">—</strong>
        </article>
        <article>
          <span>主题标签</span>
          <strong id="metric-tag-count">—</strong>
        </article>
        <article>
          <span>架构</span>
          <strong>Astro SSG</strong>
        </article>
      </div>
    </article>
    <aside class="hero-side card">
      <h3>编写原则</h3>
      <ul>
        <li>概念先定义，再给边界。</li>
        <li>从工程实践反推知识结构。</li>
        <li>优先写可复用结论。</li>
      </ul>
    </aside>
  </section>

  <section id="featured-section" class="reveal" style="animation-delay: 120ms; display:none;">
    <div class="section-head">
      <h3>精选文章</h3>
    </div>
    <article id="featured-card" class="card feature-card"></article>
  </section>

  <section class="reveal" style="animation-delay: 200ms;">
    <div class="section-head">
      <h3>最近更新</h3>
      <a href="/archive/">按时间排序</a>
    </div>
    <div id="post-list-container">
      <p class="meta">正在加载文章...</p>
    </div>
  </section>

  <script>
    import { supabase } from "../lib/supabase-browser";
    import { esc } from "../lib/html";

    const POST_FIELDS = "slug,title,content,tags,excerpt,updated_at,created_at";

    function getDisplayDate(post: { updated_at: string; created_at: string }): string {
      return new Date(post.updated_at || post.created_at).toLocaleDateString("zh-CN");
    }

    function getSummary(post: {
      excerpt: string | null;
      content: string;
    }): string {
      if (post.excerpt && post.excerpt.trim().length > 0) return post.excerpt;
      const plain = post.content.replace(/[#>*`\-]/g, " ").replace(/\s+/g, " ").trim();
      return plain.length > 140 ? `${plain.slice(0, 140)}...` : plain;
    }

    function renderTags(tags: string[] | null): string {
      if (!tags?.length) return "";
      return `<ul class="tags">${tags.map((t) => `<li>${esc(t)}</li>`).join("")}</ul>`;
    }

    function renderPostCard(post: {
      slug: string;
      title: string;
      content: string;
      tags: string[] | null;
      excerpt: string | null;
      updated_at: string;
      created_at: string;
    }, extraClass = ""): string {
      return `
        <article class="card post-item${extraClass ? " " + extraClass : ""}">
          <p class="meta">${getDisplayDate(post)}</p>
          <h4><a href="/posts/${esc(post.slug)}/">${esc(post.title)}</a></h4>
          <p>${esc(getSummary(post))}</p>
          ${renderTags(post.tags)}
        </article>`;
    }

    async function loadPosts() {
      const { data, error } = await supabase
        .from("posts")
        .select(POST_FIELDS)
        .order("updated_at", { ascending: false });

      const container = document.getElementById("post-list-container");
      if (!container) return;

      if (error || !data || data.length === 0) {
        container.innerHTML = "<p>数据库暂无文章，请先执行导入 SQL。</p>";
        return;
      }

      const postCountEl = document.getElementById("metric-post-count");
      const tagCountEl = document.getElementById("metric-tag-count");
      if (postCountEl) postCountEl.textContent = String(data.length);
      if (tagCountEl) {
        const tagCount = new Set(data.flatMap((p) => p.tags || [])).size;
        tagCountEl.textContent = String(tagCount);
      }

      const featuredSection = document.getElementById("featured-section");
      const featuredCard = document.getElementById("featured-card");
      if (featuredSection && featuredCard) {
        const featured = data[0];
        featuredCard.innerHTML = `
          <p class="meta">${getDisplayDate(featured)}</p>
          <h4><a href="/posts/${esc(featured.slug)}/">${esc(featured.title)}</a></h4>
          <p>${esc(getSummary(featured))}</p>
          ${renderTags(featured.tags)}`;
        featuredSection.style.display = "";
      }

      const latest = data.length > 1 ? data.slice(1) : data;
      container.innerHTML = `<div class="post-list">${latest.map((p) => renderPostCard(p)).join("")}</div>`;
    }

    loadPosts();
  </script>
</BaseLayout>
