---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { marked } from "marked";
import { fetchPostBySlug, getPostDisplayDate, getPostSummary } from "../../lib/posts";

const { slug } = Astro.params;

if (!slug || !/^[\p{L}\p{N}][\p{L}\p{N}\-_.]*$/u.test(slug) || slug.length > 300) {
    return Astro.redirect("/404");
}

const post = await fetchPostBySlug(slug);

if (!post) {
    return Astro.redirect("/404");
}

const html = await marked.parse(post.content);
---

<BaseLayout title={`${post.title} | 笔记博客`} description={getPostSummary(post)}>
  <article class="card">
    <h2>{post.title}</h2>
    <p class="meta">{getPostDisplayDate(post).toLocaleDateString("zh-CN")}</p>
    <div class="post-content" set:html={html} />
  </article>
</BaseLayout>
