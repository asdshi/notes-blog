# Public browser envs (fill with your Supabase project values)
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secret (do NOT expose in client code)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: use a Supabase user login for RLS-enabled inserts
SUPABASE_EMAIL=
SUPABASE_PASSWORD=